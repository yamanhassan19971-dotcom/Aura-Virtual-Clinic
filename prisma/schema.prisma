generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRACTICE_MANAGER
  RECEPTIONIST
  CLINICIAN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_SURGERY
  COMPLETED
  CANCELLED
  FTA
}

// Phase 2 enums ---------------------------------------------------------

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PatientContactMethod {
  PHONE
  WHATSAPP
  SMS
  EMAIL
}

// A single row describes "patient's relation TO relatedPatient" (e.g.
// patient=Ahmed, relatedPatient=Omar, type=CHILD means "Omar is Ahmed's
// child"). The service layer computes the reciprocal label when rendering
// from the other patient's side, so there is exactly one row per link.
enum FamilyRelationType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  GUARDIAN
  OTHER
}

enum MedicalHistoryStatus {
  CURRENT
  PREVIOUS
}

enum MedicalAnswerValue {
  YES
  NO
  UNKNOWN
  NOT_APPLICABLE
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

enum DocumentCategory {
  RADIOGRAPH
  CLINICAL_PHOTOGRAPH
  REFERRAL
  MEDICAL_REPORT
  CONSENT
  LAB
  CORRESPONDENCE
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Phase 3 enums ---------------------------------------------------------

enum DentitionType {
  PERMANENT
  DECIDUOUS
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  BUCCAL
  LINGUAL
}

enum ChartEntryStatus {
  EXISTING
  PLANNED
  COMPLETED
}

enum ClinicalImageCategory {
  INTRAORAL_PHOTO
  EXTRAORAL_PHOTO
  RADIOGRAPH
  OTHER
}

enum BpeSextant {
  UPPER_RIGHT
  UPPER_ANTERIOR
  UPPER_LEFT
  LOWER_RIGHT
  LOWER_ANTERIOR
  LOWER_LEFT
}

// A physical clinic location. Every clinical/scheduling record hangs off a
// practice so Phase 2+ can add more locations without a schema change.
model Practice {
  id       String @id @default(cuid())
  name     String
  timezone String @default("Asia/Damascus")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms                 Room[]
  practitioners         Practitioner[]
  patients              Patient[]
  users                 User[]
  appointmentTypes      AppointmentType[]
  appointments          Appointment[]
  workingHours          WorkingHours[]
  clinicalNoteTemplates ClinicalNoteTemplate[]
  clinicalNotes         ClinicalNote[]
  patientTasks          PatientTask[]
  chartEntries          ChartEntry[]
  bpeExams              BpeExam[]
  clinicalImages        ClinicalImage[]

  @@map("practices")
}

model Room {
  id         String  @id @default(cuid())
  practiceId String  @map("practice_id")
  name       String
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice                Practice       @relation(fields: [practiceId], references: [id])
  appointments            Appointment[]
  defaultForPractitioners Practitioner[] @relation("DefaultRoom")

  @@index([practiceId])
  @@map("rooms")
}

// Login identity. Deliberately separate from Practitioner: not every user is
// a clinician (receptionists, practice managers) and not every practitioner
// necessarily has a login in Phase 1.
model User {
  id           String  @id @default(cuid())
  practiceId   String  @map("practice_id")
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  role         Role
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice            Practice                   @relation(fields: [practiceId], references: [id])
  practitioner        Practitioner?
  statusChangesMade   AppointmentStatusHistory[]
  auditLogEntries     AuditLog[]
  createdAppointments Appointment[]

  // Phase 2 back-relations
  patientsCreated        Patient[]                   @relation("PatientCreatedBy")
  patientsUpdated        Patient[]                   @relation("PatientUpdatedBy")
  familyLinksCreated     PatientFamilyRelationship[]
  medicalHistoriesTaken  MedicalHistory[]
  alertsCreated          MedicalAlert[]              @relation("AlertCreatedBy")
  alertsResolved         MedicalAlert[]              @relation("AlertResolvedBy")
  noteTemplatesOwned     ClinicalNoteTemplate[]
  clinicalNotesCreated   ClinicalNote[]              @relation("NoteCreatedBy")
  clinicalNotesSigned    ClinicalNote[]              @relation("NoteSignedBy")
  clinicalNoteAmendments ClinicalNoteAmendment[]
  patientNotesCreated    PatientNote[]
  documentsUploaded      PatientDocument[]
  tasksAssigned          PatientTask[]               @relation("TaskAssignedTo")
  tasksCreated           PatientTask[]               @relation("TaskCreatedBy")
  flagsCreated           PatientFlag[]

  // Phase 3 back-relations
  chartEntriesCreated    ChartEntry[]    @relation("ChartEntryCreatedBy")
  chartEntriesResolved   ChartEntry[]    @relation("ChartEntryResolvedBy")
  bpeExamsCreated        BpeExam[]
  clinicalImagesUploaded ClinicalImage[]

  @@index([practiceId])
  @@map("users")
}

model Practitioner {
  id            String  @id @default(cuid())
  practiceId    String  @map("practice_id")
  userId        String? @unique @map("user_id")
  name          String
  title         String // e.g. "Dentist", "Hygienist"
  colorHex      String  @default("#3B82F6") @map("color_hex")
  defaultRoomId String? @map("default_room_id")
  active        Boolean @default(true)
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice            Practice       @relation(fields: [practiceId], references: [id])
  user                User?          @relation(fields: [userId], references: [id])
  defaultRoom         Room?          @relation("DefaultRoom", fields: [defaultRoomId], references: [id])
  appointments        Appointment[]
  workingHours        WorkingHours[]
  preferredByPatients Patient[]      @relation("PreferredPractitioner")
  clinicalNotes       ClinicalNote[]
  chartEntries        ChartEntry[]
  bpeExams            BpeExam[]

  @@index([practiceId])
  @@map("practitioners")
}

// Practice-wide rows have practitionerId = null; a practitioner-specific row
// overrides the practice default for that weekday (Phase 2 hook, seeded
// simply for now per the brief).
model WorkingHours {
  id             String  @id @default(cuid())
  practiceId     String  @map("practice_id")
  practitionerId String? @map("practitioner_id")
  weekday        Int // 0 = Sunday .. 6 = Saturday
  startMinute    Int     @map("start_minute")
  endMinute      Int     @map("end_minute")

  practice     Practice      @relation(fields: [practiceId], references: [id])
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id])

  @@index([practiceId, weekday])
  @@map("working_hours")
}

model Patient {
  id          String        @id @default(cuid())
  practiceId  String        @map("practice_id")
  patientCode String        @unique @map("patient_code")
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  dateOfBirth DateTime      @map("date_of_birth") @db.Date
  phone       String? // mobile phone — the original Phase 1 field
  email       String?
  notes       String? // legacy free-text field, superseded by PatientNote
  status      PatientStatus @default(ACTIVE)

  // Personal details
  middleName        String? @map("middle_name")
  preferredName     String? @map("preferred_name")
  title             String?
  gender            String?
  preferredLanguage String? @map("preferred_language")

  // Contact details
  homePhone    String? @map("home_phone")
  workPhone    String? @map("work_phone")
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  country      String?
  postalCode   String? @map("postal_code")

  // Emergency contact
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactRelationship String? @map("emergency_contact_relationship")
  emergencyContactPhone        String? @map("emergency_contact_phone")
  emergencyContactNotes        String? @map("emergency_contact_notes")

  // Practice preferences
  preferredPractitionerId String?               @map("preferred_practitioner_id")
  acquisitionSource       String?               @map("acquisition_source")
  preferredContactMethod  PatientContactMethod? @map("preferred_contact_method")
  recallPreference        String?               @map("recall_preference")

  createdById String? @map("created_by")
  updatedById String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice              Practice      @relation(fields: [practiceId], references: [id])
  preferredPractitioner Practitioner? @relation("PreferredPractitioner", fields: [preferredPractitionerId], references: [id])
  createdBy             User?         @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?         @relation("PatientUpdatedBy", fields: [updatedById], references: [id])
  appointments          Appointment[]

  familyLinksFrom  PatientFamilyRelationship[] @relation("FamilyFrom")
  familyLinksTo    PatientFamilyRelationship[] @relation("FamilyTo")
  medicalHistories MedicalHistory[]
  medicalAlerts    MedicalAlert[]
  clinicalNotes    ClinicalNote[]
  patientNotes     PatientNote[]
  documents        PatientDocument[]
  tasks            PatientTask[]
  flags            PatientFlag[]
  chartEntries     ChartEntry[]
  bpeExams         BpeExam[]
  clinicalImages   ClinicalImage[]

  @@index([practiceId])
  @@index([lastName, firstName])
  @@map("patients")
}

model PatientFamilyRelationship {
  id               String             @id @default(cuid())
  patientId        String             @map("patient_id")
  relatedPatientId String             @map("related_patient_id")
  relationType     FamilyRelationType @map("relation_type")
  createdById      String?            @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  patient        Patient @relation("FamilyFrom", fields: [patientId], references: [id])
  relatedPatient Patient @relation("FamilyTo", fields: [relatedPatientId], references: [id])
  createdBy      User?   @relation(fields: [createdById], references: [id])

  @@unique([patientId, relatedPatientId])
  @@index([relatedPatientId])
  @@map("patient_family_relationships")
}

// Every submission creates a NEW row; the previous CURRENT row is flipped to
// PREVIOUS in the same transaction. Never update answers on an existing
// CURRENT history in place — that would silently rewrite clinical history.
model MedicalHistory {
  id            String               @id @default(cuid())
  patientId     String               @map("patient_id")
  status        MedicalHistoryStatus @default(CURRENT)
  completedById String?              @map("completed_by")
  completedAt   DateTime             @default(now()) @map("completed_at")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")

  patient     Patient                @relation(fields: [patientId], references: [id])
  completedBy User?                  @relation(fields: [completedById], references: [id])
  answers     MedicalHistoryAnswer[]
  alerts      MedicalAlert[]

  @@index([patientId, status])
  @@map("medical_histories")
}

// category/questionKey come from a code-defined catalog (see
// lib/medical/question-catalog.ts) rather than a database table, so the
// question set can grow without a migration; the catalog key is what's
// stored, making the row set effectively configurable.
model MedicalHistoryAnswer {
  id               String              @id @default(cuid())
  medicalHistoryId String              @map("medical_history_id")
  category         String
  questionKey      String              @map("question_key")
  answer           MedicalAnswerValue?
  freeText         String?             @map("free_text")

  medicalHistory MedicalHistory @relation(fields: [medicalHistoryId], references: [id])

  @@index([medicalHistoryId])
  @@map("medical_history_answers")
}

// Never hard-deleted — "removing" an alert sets active=false and stamps who
// resolved it, so the clinical record stays traceable.
model MedicalAlert {
  id               String    @id @default(cuid())
  patientId        String    @map("patient_id")
  medicalHistoryId String?   @map("medical_history_id")
  label            String
  active           Boolean   @default(true)
  createdById      String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedById     String?   @map("resolved_by")

  patient        Patient         @relation(fields: [patientId], references: [id])
  medicalHistory MedicalHistory? @relation(fields: [medicalHistoryId], references: [id])
  createdBy      User?           @relation("AlertCreatedBy", fields: [createdById], references: [id])
  resolvedBy     User?           @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([patientId, active])
  @@map("medical_alerts")
}

// ownerUserId = null -> practice-wide template; set -> personal template.
model ClinicalNoteTemplate {
  id          String  @id @default(cuid())
  practiceId  String  @map("practice_id")
  ownerUserId String? @map("owner_user_id")
  title       String
  body        String
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  practice  Practice @relation(fields: [practiceId], references: [id])
  ownerUser User?    @relation(fields: [ownerUserId], references: [id])

  @@index([practiceId])
  @@map("clinical_note_templates")
}

// A signed note's `content` is permanently frozen; corrections after signing
// go through ClinicalNoteAmendment, never an edit to `content` itself.
model ClinicalNote {
  id             String             @id @default(cuid())
  practiceId     String             @map("practice_id")
  patientId      String             @map("patient_id")
  appointmentId  String?            @map("appointment_id")
  practitionerId String             @map("practitioner_id")
  status         ClinicalNoteStatus @default(DRAFT)
  content        String
  signedAt       DateTime?          @map("signed_at")
  signedById     String?            @map("signed_by")
  createdById    String?            @map("created_by")

  // Phase 3: optional link from a clinical note to the specific tooth/chart
  // entry it was written about, so a note can surface in that tooth's
  // history. Both stay nullable — every Phase 2 note (and any Phase 3 note
  // not tied to charting) is unaffected.
  toothNumber  String? @map("tooth_number")
  chartEntryId String? @map("chart_entry_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice     Practice                @relation(fields: [practiceId], references: [id])
  patient      Patient                 @relation(fields: [patientId], references: [id])
  appointment  Appointment?            @relation(fields: [appointmentId], references: [id])
  practitioner Practitioner            @relation(fields: [practitionerId], references: [id])
  signedBy     User?                   @relation("NoteSignedBy", fields: [signedById], references: [id])
  createdBy    User?                   @relation("NoteCreatedBy", fields: [createdById], references: [id])
  chartEntry   ChartEntry?             @relation(fields: [chartEntryId], references: [id])
  amendments   ClinicalNoteAmendment[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([chartEntryId])
  @@map("clinical_notes")
}

model ClinicalNoteAmendment {
  id             String  @id @default(cuid())
  clinicalNoteId String  @map("clinical_note_id")
  content        String
  createdById    String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([clinicalNoteId])
  @@map("clinical_note_amendments")
}

// Administrative/non-clinical notes — deliberately a separate model from
// ClinicalNote so the two are never rendered or queried together.
model PatientNote {
  id          String  @id @default(cuid())
  patientId   String  @map("patient_id")
  content     String
  createdById String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@map("patient_notes")
}

// Soft-deleted only (deletedAt) — a healthcare document is never truly
// removed, just hidden from normal views. storageKey is a path inside the
// private, non-public-served upload root (see lib/documents/storage.ts).
model PatientDocument {
  id           String           @id @default(cuid())
  patientId    String           @map("patient_id")
  filename     String
  storageKey   String           @map("storage_key")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  category     DocumentCategory @default(OTHER)
  description  String?
  uploadedById String?          @map("uploaded_by")

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])

  @@index([patientId])
  @@map("patient_documents")
}

model PatientTask {
  id               String     @id @default(cuid())
  practiceId       String     @map("practice_id")
  patientId        String     @map("patient_id")
  appointmentId    String?    @map("appointment_id")
  title            String
  status           TaskStatus @default(OPEN)
  assignedToUserId String?    @map("assigned_to_user_id")
  dueAt            DateTime?  @map("due_at")
  createdById      String?    @map("created_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  practice    Practice     @relation(fields: [practiceId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  assignedTo  User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy   User?        @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([patientId])
  @@index([practiceId, status])
  @@map("patient_tasks")
}

// flagKey comes from a code-defined catalog (lib/patients/flag-catalog.ts),
// same configurability approach as medical question keys above.
model PatientFlag {
  id          String  @id @default(cuid())
  patientId   String  @map("patient_id")
  flagKey     String  @map("flag_key")
  notes       String?
  active      Boolean @default(true)
  createdById String? @map("created_by")

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([patientId, active])
  @@map("patient_flags")
}

model AppointmentType {
  id                 String  @id @default(cuid())
  practiceId         String  @map("practice_id")
  name               String
  defaultDurationMin Int     @map("default_duration_min")
  colorHex           String  @default("#3B82F6") @map("color_hex")
  active             Boolean @default(true)
  sortOrder          Int     @default(0) @map("sort_order")

  practice     Practice      @relation(fields: [practiceId], references: [id])
  appointments Appointment[]

  @@index([practiceId])
  @@map("appointment_types")
}

// The single most important table in Phase 1. Every mutation to this model
// must go through AppointmentService so conflict checks, permission checks,
// status history and audit logging stay in one transaction. Rows are never
// deleted; cancel/FTA are statuses with a stored reason and timestamp.
model Appointment {
  id                String            @id @default(cuid())
  practiceId        String            @map("practice_id")
  patientId         String            @map("patient_id")
  practitionerId    String            @map("practitioner_id")
  roomId            String            @map("room_id")
  appointmentTypeId String            @map("appointment_type_id")
  date              DateTime          @db.Date
  startTime         DateTime          @map("start_time")
  endTime           DateTime          @map("end_time")
  durationMin       Int               @map("duration_min")
  status            AppointmentStatus @default(PENDING)
  notes             String?

  conflictOverride       Boolean @default(false) @map("conflict_override")
  conflictOverrideById   String? @map("conflict_override_by")
  conflictOverrideReason String? @map("conflict_override_reason")

  cancellationReason String? @map("cancellation_reason")
  ftaReason          String? @map("fta_reason")

  arrivedAt   DateTime? @map("arrived_at")
  inSurgeryAt DateTime? @map("in_surgery_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  ftaAt       DateTime? @map("fta_at")

  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  practice        Practice                   @relation(fields: [practiceId], references: [id])
  patient         Patient                    @relation(fields: [patientId], references: [id])
  practitioner    Practitioner               @relation(fields: [practitionerId], references: [id])
  room            Room                       @relation(fields: [roomId], references: [id])
  appointmentType AppointmentType            @relation(fields: [appointmentTypeId], references: [id])
  createdBy       User?                      @relation(fields: [createdById], references: [id])
  statusHistory   AppointmentStatusHistory[]
  clinicalNotes   ClinicalNote[]
  tasks           PatientTask[]
  chartEntries    ChartEntry[]

  @@index([practitionerId, date])
  @@index([practiceId, date])
  @@index([roomId, date])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id             String             @id @default(cuid())
  appointmentId  String             @map("appointment_id")
  previousStatus AppointmentStatus? @map("previous_status")
  newStatus      AppointmentStatus  @map("new_status")
  changedById    String?            @map("changed_by")
  changedAt      DateTime           @default(now()) @map("changed_at")
  reason         String?

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// Phase 3: the dental clinical chart -------------------------------------

// A single structured fact about one tooth (or one surface of one tooth):
// a finding, existing restoration, or planned/completed treatment. Rows are
// never deleted or overwritten in place — status changes and retractions
// are audited updates to the same row (mirrors MedicalAlert's
// active/resolvedAt pattern below), so a tooth's full history is always
// reconstructable from this table alone. `itemCode` comes from a
// code-defined catalog (lib/dental/chart-item-catalog.ts), the same
// configurability approach as medical question keys and patient flags
// above — Phase 4 can extend the vocabulary without a migration.
// `toothNumber` is the FDI notation code (lib/dental/teeth.ts validates it
// and derives `dentitionType`); teeth are a fixed, non-patient-specific
// domain, so there is deliberately no separate Tooth table to join to.
model ChartEntry {
  id             String           @id @default(cuid())
  practiceId     String           @map("practice_id")
  patientId      String           @map("patient_id")
  toothNumber    String           @map("tooth_number")
  dentitionType  DentitionType    @map("dentition_type")
  surface        ToothSurface? // null = whole-tooth charting, not a surface-specific finding
  itemCode       String           @map("item_code")
  status         ChartEntryStatus @default(EXISTING)
  recordedDate   DateTime         @default(now()) @map("recorded_date") @db.Date
  practitionerId String?          @map("practitioner_id")
  appointmentId  String?          @map("appointment_id")
  note           String?

  active       Boolean   @default(true)
  completedAt  DateTime? @map("completed_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by")
  createdById  String?   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice       Practice        @relation(fields: [practiceId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  practitioner   Practitioner?   @relation(fields: [practitionerId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  createdBy      User?           @relation("ChartEntryCreatedBy", fields: [createdById], references: [id])
  resolvedBy     User?           @relation("ChartEntryResolvedBy", fields: [resolvedById], references: [id])
  clinicalNotes  ClinicalNote[]
  clinicalImages ClinicalImage[]

  @@index([patientId, toothNumber])
  @@index([practiceId, patientId])
  @@map("chart_entries")
}

// Foundation-level periodontal screening only (six BPE sextant codes) — not
// full pocket-chart periodontal charting; see AGENTS/Phase 3 brief section
// 16. A future phase can add detail tables (pocket depths, recession,
// bleeding, mobility, furcation, plaque) without touching this shape.
model BpeExam {
  id             String   @id @default(cuid())
  practiceId     String   @map("practice_id")
  patientId      String   @map("patient_id")
  practitionerId String?  @map("practitioner_id")
  examDate       DateTime @default(now()) @map("exam_date") @db.Date
  notes          String?
  createdById    String?  @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  practice     Practice          @relation(fields: [practiceId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  practitioner Practitioner?     @relation(fields: [practitionerId], references: [id])
  createdBy    User?             @relation(fields: [createdById], references: [id])
  scores       BpeSextantScore[]

  @@index([patientId])
  @@map("bpe_exams")
}

// `code` is the standard BPE score 0-4, or "*" for furcation involvement.
model BpeSextantScore {
  id        String     @id @default(cuid())
  bpeExamId String     @map("bpe_exam_id")
  sextant   BpeSextant
  code      String

  bpeExam BpeExam @relation(fields: [bpeExamId], references: [id])

  @@unique([bpeExamId, sextant])
  @@map("bpe_sextant_scores")
}

// Clinical images/radiographs — deliberately a separate model from
// PatientDocument (administrative/general documents): gated by
// patients.viewClinical/manageClinicalImages rather than
// patients.manageDocuments (a Receptionist can manage documents but must
// not see clinical images), and can optionally attach to a specific tooth
// or ChartEntry. Reuses the same private file-storage abstraction as
// PatientDocument (lib/documents/storage.ts) and the same soft-delete
// pattern — a clinical image is never truly removed, just hidden.
model ClinicalImage {
  id           String                @id @default(cuid())
  practiceId   String                @map("practice_id")
  patientId    String                @map("patient_id")
  toothNumber  String?               @map("tooth_number")
  chartEntryId String?               @map("chart_entry_id")
  category     ClinicalImageCategory @default(OTHER)
  filename     String
  storageKey   String                @map("storage_key")
  mimeType     String                @map("mime_type")
  sizeBytes    Int                   @map("size_bytes")
  description  String?
  capturedDate DateTime              @default(now()) @map("captured_date") @db.Date
  uploadedById String?               @map("uploaded_by")

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  practice   Practice    @relation(fields: [practiceId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id])
  chartEntry ChartEntry? @relation(fields: [chartEntryId], references: [id])
  uploadedBy User?       @relation(fields: [uploadedById], references: [id])

  @@index([patientId])
  @@map("clinical_images")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  action        String
  recordType    String   @map("record_type")
  recordId      String   @map("record_id")
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([recordType, recordId])
  @@map("audit_log")
}
